{
  "manifest_version": 3,
  "name": "qiangpiao",
  "version": "0.1.0",
  "description": "Compliant Ticketmaster US purchase helper: watch list, seat/section assist, and one-click path toward checkout. You complete queue, CAPTCHA, and payment yourself.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.ticketmaster.com/*",
    "https://ticketmaster.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "qiangpiao",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ticketmaster.com/*",
        "https://ticketmaster.com/*"
      ],
      "js": ["shared/storage.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
